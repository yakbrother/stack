---
import Base from "../../layouts/Base.astro";
import NoteCard from "../../components/NoteCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return [
    { params: { collection: "concepts" } },
    { params: { collection: "entities" } },
    { params: { collection: "tools" } },
    { params: { collection: "patterns" } },
    { params: { collection: "sources" } },
    { params: { collection: "synthesis" } },
    { params: { collection: "sessions" } },
  ];
}

const { collection } = Astro.params;

const LABELS: Record<string, { title: string; description: string; kicker: string }> = {
  concepts:  { title: "Concepts",  description: "Foundational ideas, principles, architectures, and threat models.", kicker: "// section" },
  entities:  { title: "Entities",  description: "Named organizations, frameworks, standards, and projects.", kicker: "// section" },
  tools:     { title: "Tools",     description: "Specific tools, services, and libraries.", kicker: "// section" },
  patterns:  { title: "Patterns",  description: "Reusable solutions to recurring design and security problems.", kicker: "// section" },
  sources:   { title: "Sources",   description: "Summaries of ingested articles, papers, and documentation.", kicker: "// section" },
  synthesis: { title: "Synthesis", description: "Cross-cutting analyses, comparisons, and filed answers.", kicker: "// section" },
  sessions:  { title: "Sessions",  description: "Saved summaries of notable conversations with Claude.", kicker: "// section" },
};
const meta = LABELS[collection] ?? { title: collection, description: "", kicker: "// section" };

// @ts-ignore
const entries = await getCollection(collection, (e) => !e.data.draft);
entries.sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());

// Group by "YYYY · Long Month" (uses updated date — matches "Latest" mental model).
const grouped = new Map<string, typeof entries>();
for (const e of entries) {
  const d = e.data.updated;
  const key = `${d.getUTCFullYear()} · ${d.toLocaleString("en-US", { month: "long", timeZone: "UTC" })}`;
  if (!grouped.has(key)) grouped.set(key, [] as typeof entries);
  grouped.get(key)!.push(e);
}
const groups = Array.from(grouped.entries());
---

<Base title={meta.title} description={meta.description} activeSection={collection} activeNav="notes">
  <header class="stack" style="--_stack-gap: var(--space-xs);">
    <div class="hero__kicker">{meta.kicker}</div>
    <h1>{meta.title}</h1>
    {meta.description && <p class="hero__sub">{meta.description}</p>}
    <div class="row">
      <span class="mono" style="font-size:var(--font-size-xs);color:var(--color-muted);">
        {entries.length} note{entries.length === 1 ? "" : "s"}
      </span>
    </div>
  </header>

  {entries.length === 0 ? (
    <p style="color:var(--color-muted);font-style:italic;margin-top:var(--space-l);">
      No pages here yet.
    </p>
  ) : (
    groups.map(([month, items]) => (
      <section class="stack" style="--_stack-gap: var(--space-xs);">
        <SectionHead title={month} count={String(items.length).padStart(2, "0")} />
        <div>
          {items.map((entry) => (
            <NoteCard
              href={`/${collection}/${entry.id}/`}
              title={entry.data.title}
              excerpt={entry.data.summary}
              date={entry.data.updated}
              tags={entry.data.tags}
              dateFormat="day"
            />
          ))}
        </div>
      </section>
    ))
  )}
</Base>
