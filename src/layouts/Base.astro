---
import "../styles/tokens.css";
import "../styles/site.css";
import Topbar from "../components/Topbar.astro";
import LeftRail from "../components/LeftRail.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Active section key for nav + LeftRail highlight (collection name like "concepts"). */
  activeSection?: string;
  /** Active top-nav key — "home" | "notes" | "tags" | "about". */
  activeNav?: string;
  /** Layout variant. "default" = three zones; "narrow" = single column 64rem cap; "wide" = left rail + main, no right rail. */
  variant?: "default" | "narrow" | "wide";
  /** When true, render the left rail. Default true (false for narrow). */
  showLeftRail?: boolean;
  /** When true, render the right-rail slot wrapper. Default true (false for narrow + wide). */
  showRightRail?: boolean;
}

const {
  title,
  description = "A working notebook on system design, security engineering, and AI agent architecture.",
  activeSection,
  activeNav,
  variant = "default",
  showLeftRail,
  showRightRail,
} = Astro.props;

const pageTitle = title ? `${title} — stack.yakbrother.dev` : "stack.yakbrother.dev";

// Default rail visibility per variant; allow per-page override.
// Right rail is only rendered when a page actually fills the slot — avoids
// the empty 14rem column that would otherwise squeeze the main column.
const hasRightSlot = Astro.slots.has("right-rail");
const showLeft = showLeftRail ?? (variant !== "narrow");
const showRight = (showRightRail ?? (variant === "default")) && hasRightSlot;

// Build the .layout class. Drop the 14rem right column when there's no rail
// content; otherwise the empty column still occupies space.
const layoutClass =
  variant === "narrow" ? "layout layout--narrow"
  : variant === "wide" ? "layout layout--wide"
  : showRight ? "layout"
  : "layout layout--wide";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="author" content="Tim Eaton" />
    <link rel="alternate" type="application/rss+xml" title="stack.yakbrother.dev" href="/feed.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,500;1,400;1,500&display=swap"
    />

    <script is:inline>
      // Apply persisted theme before paint (no flash of wrong theme).
      // "system" = no data-theme attribute → light-dark() follows OS preference.
      (function () {
        var stored = localStorage.getItem("stack-theme");
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        }
      })();
    </script>
  </head>

  <body>
    <div class="site">
      <a class="skip-link" href="#main-content">Skip to main content</a>

      <Topbar active={activeNav} />

      <main id="main-content" class={layoutClass} tabindex="-1">
        {showLeft && <LeftRail active={activeSection} />}

        <div class="main">
          <slot />
        </div>

        {showRight && <slot name="right-rail" />}
      </main>

      <Footer />
    </div>
  </body>
</html>

<style is:global>
  /* Skip link — visually hidden until focused. Lifts the design's
     accessibility baseline without depending on site.css for a non-component. */
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-accent);
    color: oklch(15% 0.02 25);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
    z-index: 9999;
    transition: top 0.1s;
  }
  .skip-link:focus {
    top: var(--space-s);
  }

  main:focus { outline: none; }
</style>
